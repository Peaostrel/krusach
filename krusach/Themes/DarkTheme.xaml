<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#1E1E1E</Color>
    <Color x:Key="SidebarBackgroundColor">#252526</Color>
    <Color x:Key="HeaderTextColor">#007ACC</Color>
    <Color x:Key="MainTextColor">#D4D4D4</Color>
    <Color x:Key="CardBackgroundColor">#2D2D30</Color>
    <Color x:Key="GridBackgroundColor">#252526</Color>
    <Color x:Key="ActionBackgroundColor">#333333</Color>
    <Color x:Key="PanelBackgroundColor">#2A2D2E</Color>
    <Color x:Key="SeparatorColor">#333333</Color>
    <Color x:Key="ControlBackgroundColor">#1E1E1E</Color>
    <Color x:Key="ControlBorderColor">#444444</Color>
    <Color x:Key="SidebarItemSelectedColor">#37373D</Color>
    <Color x:Key="SidebarItemHoverColor">#2A2D2E</Color>
    <Color x:Key="ButtonBackgroundColor">#3E3E42</Color>
    <Color x:Key="ButtonForegroundColor">#FFFFFF</Color>
    
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="HeaderTextBrush" Color="{StaticResource HeaderTextColor}"/>
    <SolidColorBrush x:Key="MainTextBrush" Color="{StaticResource MainTextColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="GridBackgroundBrush" Color="{StaticResource GridBackgroundColor}"/>
    <SolidColorBrush x:Key="ActionBackgroundBrush" Color="{StaticResource ActionBackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorColor}"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlBackgroundColor}"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource ControlBorderColor}"/>
    <SolidColorBrush x:Key="SidebarItemSelectedBrush" Color="{StaticResource SidebarItemSelectedColor}"/>
    <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="{StaticResource SidebarItemHoverColor}"/>
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource ButtonBackgroundColor}"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="{StaticResource ButtonForegroundColor}"/>
    <SolidColorBrush x:Key="GridAlternatingRowBrush" Color="#FFFFFF" Opacity="0.05"/>
</ResourceDictionary>
