<Window x:Class="krusach.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:krusach"
        xmlns:conv="clr-namespace:krusach.Converters"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="Оптовая База 2.0" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource MainTextBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <conv:LowStockConverter x:Key="LowStockConverter"/>
            <conv:WidthPercentageConverter x:Key="WidthPercentageConverter"/>
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
            <conv:RatingToStarsConverter x:Key="RatingToStarsConverter"/>
            <conv:RoleToBooleanConverter x:Key="RoleToBooleanConverter"/>
            <conv:BooleanToStringConverter x:Key="BooleanToStringConverter"/>
            <conv:RoleToVisibilityConverter x:Key="RoleToVisibilityConverter"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

            <Style x:Key="ModernButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
                <Setter Property="Padding" Value="15,8"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Style.Resources>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.8"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SidebarButton" TargetType="RadioButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border Name="Border" Background="Transparent" Padding="20,12" Margin="0,2">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource SidebarItemSelectedBrush}"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                                    <Setter TargetName="Border" Property="BorderThickness" Value="4,0,0,0"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource SidebarItemHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <Style x:Key="ModernGrid" TargetType="DataGrid">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="RowBackground" Value="Transparent"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource GridAlternatingRowBrush}"/>
                <Setter Property="GridLinesVisibility" Value="None"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="ColumnHeaderStyle">
                    <Setter.Value>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
                            <Setter Property="Padding" Value="10,15"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Style.Resources>
                <Style.Triggers>
                    <Trigger Property="IsFocused" Value="True">
                        <Setter Property="BorderBrush" Value="#007ACC"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="PasswordBox">
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Style.Resources>
            </Style>

            <Style TargetType="DatePicker">
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Menu (Scrollable) -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ОПТ ТОРГ" Foreground="{DynamicResource HeaderTextBrush}" FontWeight="Bold" FontSize="20" Margin="20,30,20,40" HorizontalAlignment="Center"/>
                        
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <!-- Dashboard -->
                            <RadioButton Style="{StaticResource SidebarButton}" IsChecked="True" Name="RbDashboard">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" SharedSizeGroup="SidebarIconCol"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Дашборд" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </RadioButton>

                            <!-- Products -->
                            <RadioButton Style="{StaticResource SidebarButton}" Name="RbProducts">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" SharedSizeGroup="SidebarIconCol"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Товары" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </RadioButton>

                            <!-- Categories -->
                            <RadioButton Style="{StaticResource SidebarButton}" Name="RbCategories">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" SharedSizeGroup="SidebarIconCol"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Категории" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </RadioButton>

                            <!-- Contractors -->
                            <RadioButton Style="{StaticResource SidebarButton}" Name="RbContractors">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" SharedSizeGroup="SidebarIconCol"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Контрагенты" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </RadioButton>

                            <!-- Orders -->
                            <RadioButton Style="{StaticResource SidebarButton}" Name="RbOrders">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" SharedSizeGroup="SidebarIconCol"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Заказы" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </RadioButton>

                            <!-- Logs -->
                            <RadioButton Style="{StaticResource SidebarButton}" Name="RbLogs">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" SharedSizeGroup="SidebarIconCol"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Журнал" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </RadioButton>

                            <!-- Requests (Admin Only) -->
                            <RadioButton Style="{StaticResource SidebarButton}" Name="RbRequests" 
                                         Visibility="{Binding CurrentUser.Role, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=Admin}">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" SharedSizeGroup="SidebarIconCol"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="Заявки" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </RadioButton>
                        </StackPanel>
                        
                        <Separator Background="{DynamicResource SeparatorBrush}" Margin="10,20"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Actions (Fixed) -->
                <StackPanel Grid.Row="1" Margin="10">
                    <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,10" Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentUser.FullName}" Foreground="{DynamicResource MainTextBrush}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CurrentUser.Role}" Foreground="#888888" FontSize="10"/>
                            <Button Content="🚪 Выйти" Style="{StaticResource ModernButton}" Click="BtnLogout_Click" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <CheckBox Content="Светлая тема" Foreground="{DynamicResource MainTextBrush}" Name="CbLightTheme" Click="CbLightTheme_Click" Margin="5"/>
                    <Button Content="Бэкап БД" Style="{StaticResource ModernButton}" Click="BtnBackup_Click"/>
                    <Button Content="Экспорт CSV" Style="{StaticResource ModernButton}" Click="BtnExport_Click"/>
                    <Button Content="Обновить БД" Style="{StaticResource ModernButton}" Click="BtnLoad_Click"/>
                    <Button Content="Сохранить" Style="{StaticResource ModernButton}" Background="#007ACC" Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Управление базой данных" FontSize="24" FontWeight="Light" Margin="0,0,0,20"/>

            <Grid Grid.Row="1">
                <!-- Dashboard View -->
                <Grid Visibility="{Binding IsChecked, ElementName=RbDashboard, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical">
                            <WrapPanel Orientation="Horizontal">
                                <Border Width="180" Height="100" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Margin="0,0,20,20">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Всего товаров" Foreground="#AAAAAA" FontSize="12"/>
                                        <TextBlock Text="{Binding TotalProducts}" Foreground="{DynamicResource MainTextBrush}" FontSize="28" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Width="180" Height="100" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Margin="0,0,20,20">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Мало на складе" Foreground="#AAAAAA" FontSize="12"/>
                                        <TextBlock Text="{Binding LowStockCount}" Foreground="#E74C3C" FontSize="28" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Width="180" Height="100" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Margin="0,0,20,20">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Контрагенты" Foreground="#AAAAAA" FontSize="12"/>
                                        <TextBlock Text="{Binding TotalContractors}" Foreground="{DynamicResource MainTextBrush}" FontSize="28" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Width="180" Height="100" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Margin="0,0,20,20">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Выручка (расход)" Foreground="#AAAAAA" FontSize="12"/>
                                        <TextBlock Text="{Binding TotalSales, StringFormat=\{0:N0\} ₽}" Foreground="#2ECC71" FontSize="24" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Width="180" Height="100" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Margin="0,0,20,20">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Чистая прибыль" Foreground="#AAAAAA" FontSize="12"/>
                                        <TextBlock Text="{Binding TotalProfit, StringFormat=\{0:N0\} ₽}" Foreground="#27AE60" FontSize="24" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Width="180" Height="100" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Margin="0,0,20,20">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="Средний чек" Foreground="#AAAAAA" FontSize="12"/>
                                        <TextBlock Text="{Binding AverageOrderValue, StringFormat=\{0:N0\} ₽}" Foreground="#007ACC" FontSize="24" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Margin="0,0,10,0" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="Выручка (7 дней)" Foreground="{DynamicResource MainTextBrush}" FontSize="16" Margin="0,0,0,15"/>
                                        <lvc:CartesianChart Series="{Binding SalesSeries}" XAxes="{Binding XAxes}" Height="200"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Margin="10,0,0,0" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="Прибыль (7 дней)" Foreground="{DynamicResource MainTextBrush}" FontSize="16" Margin="0,0,0,15"/>
                                        <lvc:CartesianChart Series="{Binding ProfitSeries}" XAxes="{Binding XAxes}" Height="200"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            
                            <Button Content="⚡ Сформировать автозакупку" Style="{StaticResource ModernButton}" 
                                    Background="#E67E22" Margin="0,20,0,0" HorizontalAlignment="Left" Click="BtnAutoReorder_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Products View -->
                <Grid Visibility="{Binding IsChecked, ElementName=RbProducts, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Content="➕ Товар" Style="{StaticResource ModernButton}" Background="#27AE60" Click="BtnAddProduct_Click"/>
                            <Button Content="📝 Правка" Style="{StaticResource ModernButton}" Background="#F39C12" Click="BtnEditProduct_Click"/>
                            <Button Content="🗑 Удалить" Style="{StaticResource ModernButton}" Background="#C0392B" Click="BtnDeleteProduct_Click"
                                    IsEnabled="{Binding CurrentUser.Role, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=Admin}"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="Скачать Прайс" Style="{StaticResource ModernButton}" Click="BtnPriceList_Click"/>
                        <Border Background="{DynamicResource ActionBackgroundBrush}" CornerRadius="10" Margin="10,0" Padding="10,2">
                             <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" VerticalAlignment="Center" Opacity="0.5" Margin="0,0,10,0"/>
                                <TextBox Width="150" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" 
                                         Foreground="{DynamicResource MainTextBrush}"
                                         Text="{Binding SearchTextProducts, UpdateSourceTrigger=PropertyChanged}"/>
                             </StackPanel>
                        </Border>
                    </DockPanel>
                    
                    <DataGrid Grid.Row="1" Name="ProductsGrid" ItemsSource="{Binding ProductsView}" SelectedItem="{Binding SelectedProduct}" Style="{StaticResource ModernGrid}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="#252526" Foreground="White">
                                <MenuItem Header="📝 Редактировать" Click="BtnEditProduct_Click"/>
                                <MenuItem Header="🗑 Удалить" Click="BtnDeleteProduct_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StockQuantity, Converter={StaticResource LowStockConverter}}" Value="True">
                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Фото" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding ImagePath}" Width="30" Height="30" Stretch="UniformToFill"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="50"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name, ValidatesOnDataErrors=True}" Width="*"/>
                            <DataGridTextColumn Header="Артикул" Binding="{Binding Sku, ValidatesOnDataErrors=True}" Width="100"/>
                            <DataGridComboBoxColumn x:Name="ColCategory" Header="Категория" SelectedValueBinding="{Binding CategoryId}" DisplayMemberPath="Name" SelectedValuePath="Id" Width="120"/>
                            <DataGridTextColumn Header="Закупка" Binding="{Binding PurchasePrice, ValidatesOnDataErrors=True}" Width="80"/>
                            <DataGridTextColumn Header="Опт" Binding="{Binding WholesalePrice, ValidatesOnDataErrors=True}" Width="80"/>
                            <DataGridTextColumn Header="Остаток" Binding="{Binding StockQuantity, ValidatesOnDataErrors=True}" Width="70"/>
                            <DataGridTextColumn Header="Хватит на (дн)" Binding="{Binding DaysRemaining}" IsReadOnly="True" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Панель предпросмотра -->
                    <Border Grid.Row="1" Grid.Column="1" Margin="20,0,0,0" Background="{DynamicResource ActionBackgroundBrush}" CornerRadius="15" Padding="20">
                        <StackPanel DataContext="{Binding ElementName=ProductsGrid, Path=SelectedItem}">
                            <TextBlock Text="ПРЕДПРОСМОТР" FontWeight="Bold" Opacity="0.5" Margin="0,0,0,15" Foreground="{DynamicResource MainTextBrush}"/>
                            <Border Height="200" Background="#1A1A1C" CornerRadius="10" Margin="0,0,0,15">
                                <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource MainTextBrush}"/>
                            <TextBlock Text="{Binding Sku}" Opacity="0.6" Margin="0,5,0,0" Foreground="{DynamicResource MainTextBrush}"/>
                            <Separator Margin="0,15" Background="{DynamicResource SeparatorBrush}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="На складе: " Opacity="0.6" Foreground="{DynamicResource MainTextBrush}"/>
                                <TextBlock Text="{Binding StockQuantity}" FontWeight="Bold" Foreground="{DynamicResource MainTextBrush}"/>
                                <TextBlock Text=" шт." Opacity="0.6" Foreground="{DynamicResource MainTextBrush}"/>
                            </StackPanel>
                            <Button Content="РЕДАКТИРОВАТЬ" Margin="0,20,0,0" Style="{StaticResource ModernButton}" HorizontalAlignment="Stretch" Click="BtnEditProduct_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Categories View -->
                <Grid Visibility="{Binding IsChecked, ElementName=RbCategories, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="+ Категория" Style="{StaticResource ModernButton}" Background="#27AE60" Click="BtnAddCategory_Click"/>
                            <Button Content="✎ Правка" Style="{StaticResource ModernButton}" Background="#F39C12" Click="BtnEditCategory_Click"/>
                            <Button Content="- Удалить" Style="{StaticResource ModernButton}" Background="#C0392B" Click="BtnDeleteCategory_Click"/>
                        </StackPanel>
                        <TextBox Margin="0,5,0,0" Background="{DynamicResource ActionBackgroundBrush}" Foreground="{DynamicResource MainTextBrush}" BorderThickness="0" Padding="10,5"
                                 Tag="Поиск по категориям..."
                                 Text="{Binding SearchTextCategories, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" Name="CategoriesGrid" ItemsSource="{Binding CategoriesView}" Style="{StaticResource ModernGrid}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="#252526" Foreground="White">
                                <MenuItem Header="📝 Редактировать" Click="BtnEditCategory_Click"/>
                                <MenuItem Header="🗑 Удалить" Click="BtnDeleteCategory_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="50"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Contractors View -->
                <Grid Visibility="{Binding IsChecked, ElementName=RbContractors, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="➕ Контрагент" Style="{StaticResource ModernButton}" Background="#27AE60" Click="BtnAddContractor_Click"/>
                        <Button Content="📝 Правка" Style="{StaticResource ModernButton}" Background="#F39C12" Click="BtnEditContractor_Click"/>
                        <Button Content="🗑 Удалить" Style="{StaticResource ModernButton}" Background="#C0392B" Click="BtnDeleteContractor_Click"
                                IsEnabled="{Binding CurrentUser.Role, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=Admin}"/>
                    </StackPanel>
                    <TextBox Grid.Row="1" Margin="0,0,0,10" Background="{DynamicResource ActionBackgroundBrush}" Foreground="{DynamicResource MainTextBrush}" BorderThickness="0"
                             Text="{Binding SearchTextContractors, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGrid Grid.Row="2" Name="ContractorsGrid" ItemsSource="{Binding ContractorsView}" Style="{StaticResource ModernGrid}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="#252526" Foreground="White">
                                <MenuItem Header="📝 Редактировать" Click="BtnEditContractor_Click"/>
                                <MenuItem Header="🗑 Удалить" Click="BtnDeleteContractor_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="50"/>
                            <DataGridTextColumn Header="Рейтинг" Binding="{Binding Rating, Converter={StaticResource RatingToStarsConverter}}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Gold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="14"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="100"/>
                            <DataGridTextColumn Header="Компания" Binding="{Binding CompanyName}" Width="*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                            <DataGridTextColumn Header="ИНН" Binding="{Binding Inn}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Orders View -->
                <Grid Visibility="{Binding IsChecked, ElementName=RbOrders, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="➕ Заказ" Style="{StaticResource ModernButton}" Background="#27AE60" Click="BtnAddOrder_Click"/>
                        <Button Content="📝 Правка" Style="{StaticResource ModernButton}" Background="#F39C12" Click="BtnEditOrder_Click"/>
                        <Button Content="🗑 Удалить" Style="{StaticResource ModernButton}" Background="#C0392B" Click="BtnDeleteOrder_Click"
                                IsEnabled="{Binding CurrentUser.Role, Converter={StaticResource RoleToVisibilityConverter}, ConverterParameter=Admin}"/>
                        <Button Content="🖨 Печать" Style="{StaticResource ModernButton}" Click="BtnPrint_Click"/>
                        <Button Content="📧 Email" Style="{StaticResource ModernButton}" Background="#8E44AD" Click="BtnSendEmail_Click"/>
                    </StackPanel>
                    
                    <TextBox Grid.Row="1" Margin="0,0,0,10" Background="{DynamicResource ActionBackgroundBrush}" Foreground="{DynamicResource MainTextBrush}" BorderThickness="0" Padding="10,5"
                             Tag="Поиск по заказам..."
                             Text="{Binding SearchTextOrders, UpdateSourceTrigger=PropertyChanged}"/>
                    
                    <DataGrid Grid.Row="2" Name="OrdersGrid" ItemsSource="{Binding OrdersView}" SelectedItem="{Binding SelectedOrder}" Style="{StaticResource ModernGrid}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="#252526" Foreground="White">
                                <MenuItem Header="📝 Редактировать" Click="BtnEditOrder_Click"/>
                                <MenuItem Header="🗑 Удалить" Click="BtnDeleteOrder_Click"/>
                                <Separator Background="#444444"/>
                                <MenuItem Header="🖨 Печать накладной" Click="BtnPrint_Click"/>
                                <MenuItem Header="📧 Отправить на Email" Click="BtnSendEmail_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="50"/>
                            <DataGridComboBoxColumn x:Name="ColContractor" Header="Контрагент" SelectedValueBinding="{Binding ContractorId}" DisplayMemberPath="CompanyName" SelectedValuePath="Id" Width="150"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding OperationType}" Width="100"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                            <DataGridTextColumn Header="Скидка %" Binding="{Binding Discount}" Width="80"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding TotalSum, StringFormat=\{0:N2\} ₽}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Завершен">
                                                <Setter Property="Foreground" Value="#27AE60"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Черновик">
                                                <Setter Property="Foreground" Value="Gray"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Отменен">
                                                <Setter Property="Foreground" Value="#C0392B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="3" Height="3" HorizontalAlignment="Stretch" Background="#444444" Margin="0,5"/>
                    <DataGrid Grid.Row="4" ItemsSource="{Binding SelectedOrder.OrderDetails}" Style="{StaticResource ModernGrid}" AutoGenerateColumns="False" CanUserAddRows="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="50"/>
                            <DataGridComboBoxColumn x:Name="ColProduct" Header="Товар" SelectedValueBinding="{Binding ProductId}" DisplayMemberPath="Name" SelectedValuePath="Id" Width="150"/>
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                            <DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice, StringFormat=\{0:N2\} ₽}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Logs View -->
                <Grid Visibility="{Binding IsChecked, ElementName=RbLogs, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" x:Name="TxtSearchLogs" Text="{Binding SearchTextLogs, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,0,15"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding AuditLogsView}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MainTextBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="5,2">
                                    <TextBlock Text="{Binding Timestamp, StringFormat='[{0:HH:mm:ss}]'}" Foreground="Gray" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Username}" FontWeight="Bold" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Action}"/>
                                    <TextBlock Text="{Binding Details}" Opacity="0.6" Margin="10,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Requests View -->
                <Grid Visibility="{Binding IsChecked, ElementName=RbRequests, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Заявки на регистрацию" Foreground="{DynamicResource MainTextBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
                        <ItemsControl ItemsSource="{Binding PendingUsers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FullName}" Foreground="{DynamicResource MainTextBrush}" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Username, StringFormat='Логин: \{0\}'}" Foreground="#888888"/>
                                                <TextBlock Text="{Binding CreatedAt, StringFormat='Дата: \{0:dd.MM.yyyy HH:mm\}'}" Foreground="#888888" FontSize="10"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="Одобрить как Менеджер" Style="{StaticResource ModernButton}" Background="#27AE60" Click="BtnApproveManager_Click" Tag="{Binding}"/>
                                                <Button Content="Одобрить как Админ" Style="{StaticResource ModernButton}" Background="#007ACC" Click="BtnApproveAdmin_Click" Tag="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="#007ACC" CornerRadius="4" Margin="0,20,0,0" Padding="10,5">
                <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12"/>
            </Border>
        </Grid>


        <!-- Login / Register Overlay -->
        <Grid Grid.ColumnSpan="2" Background="{DynamicResource WindowBackgroundBrush}" Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Border Width="350" MinHeight="300" Background="{DynamicResource SidebarBackgroundBrush}" CornerRadius="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Margin="30">
                    <TextBlock Text="{Binding IsRegistering, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='ВХОД В СИСТЕМУ:РЕГИСТРАЦИЯ'}" 
                               Foreground="{DynamicResource HeaderTextBrush}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                    
                    <StackPanel Visibility="{Binding IsRegistering, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Полное имя" Foreground="#AAAAAA" FontSize="10" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding RegisterFullName, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource ActionBackgroundBrush}" Foreground="{DynamicResource MainTextBrush}" BorderThickness="0" Padding="10,5" Margin="0,0,0,15"/>
                    </StackPanel>
                    
                    <TextBlock Text="Логин" Foreground="#AAAAAA" FontSize="10" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource ActionBackgroundBrush}" Foreground="{DynamicResource MainTextBrush}" BorderThickness="0" Padding="10,5" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Пароль" Foreground="#AAAAAA" FontSize="10" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="PbPassword" Height="35" Background="{DynamicResource ActionBackgroundBrush}" Foreground="{DynamicResource MainTextBrush}" BorderThickness="0" Padding="10,5" Margin="0,0,0,10"/>
                    
                    <CheckBox Content="Запомнить меня" IsChecked="{Binding RememberMe}" Foreground="#AAAAAA" Margin="0,0,0,15"
                              Visibility="{Binding IsRegistering, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    
                    <Button Content="ВОЙТИ" Style="{StaticResource ModernButton}" Background="#007ACC" Height="40" Click="BtnLogin_Click"
                            Visibility="{Binding IsRegistering, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    
                    <Button Content="ОТПРАВИТЬ ЗАЯВКУ" Style="{StaticResource ModernButton}" Background="#27AE60" Height="40" Click="BtnRegister_Click"
                            Visibility="{Binding IsRegistering, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Button Content="{Binding IsRegistering, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='Создать аккаунт:Вернуться к входу'}" 
                            Foreground="#007ACC" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,15,0,0"
                            Click="BtnToggleRegister_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Notifications Overlay -->
        <ItemsControl Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Notifications}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="20" IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#E62D2D30" BorderBrush="{DynamicResource HeaderTextBrush}" BorderThickness="1,1,1,2" CornerRadius="4" Margin="0,0,0,10" Width="250" Padding="10">
                        <TextBlock Text="{Binding Message}" Foreground="White" TextWrapping="Wrap" FontSize="12"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
