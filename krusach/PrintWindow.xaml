<Window x:Class="krusach.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Предпросмотр заказа" Height="450" Width="400" Background="White" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="НАКЛАДНАЯ" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock x:Name="TxtContent" FontFamily="Courier New" FontSize="12"/>
            <Button Content="Закрыть" Width="100" Margin="0,20,0,0" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
