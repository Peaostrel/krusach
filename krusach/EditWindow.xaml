<Window x:Class="krusach.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование" Height="400" Width="400"
        Background="#252526" Foreground="White"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Name="TxtTitle" Text="Редактирование" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="#007ACC"/>

        <ScrollViewer Grid.Row="1">
            <StackPanel Name="FieldsPanel">
                <!-- Поля будут добавляться программно в зависимости от типа объекта -->
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="ОТМЕНА" Width="100" Margin="0,0,10,0" Padding="10,5" Background="#3E3E42" Foreground="White" Click="BtnCancel_Click"/>
            <Button Content="ОК" Width="100" Padding="10,5" Background="#007ACC" Foreground="White" Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
